{
  "release": "v0.34.0",
  "platform": "linux-64",
  "lock_url": "https://github.com/tunabirgun/bulkseq-studio/blob/v0.34.0/workflow/envs/bulkseq.lock.yaml",
  "scope": "Direct workflow tools and main analysis packages pinned in the v0.34.0 linux-64 full environment lock. It is not an inventory of every transitive dependency or a record of every program that ran in a particular project.",
  "tools": [
    {"tool":"Snakemake", "package":"snakemake-minimal", "role":"Workflow execution", "version":"9.23.1", "scope":"Direct workflow package"},
    {"tool":"Python", "package":"python", "role":"Workflow helpers and reports", "version":"3.12.13", "scope":"Direct runtime"},
    {"tool":"aria2", "package":"aria2", "role":"Resumable public-read download", "version":"1.37.0", "scope":"Direct workflow tool"},
    {"tool":"FastQC", "package":"fastqc", "role":"Read-quality checks", "version":"0.12.1", "scope":"Optional before and after trimming"},
    {"tool":"MultiQC", "package":"multiqc", "role":"QC-report aggregation", "version":"1.30", "scope":"Workflow report"},
    {"tool":"fastp", "package":"fastp", "role":"Default read trimming", "version":"1.0.1", "scope":"Alternative trimmers are available"},
    {"tool":"Cutadapt", "package":"cutadapt", "role":"Trim Galore dependency", "version":"5.2", "scope":"Trim Galore route"},
    {"tool":"Trim Galore", "package":"trim-galore", "role":"Alternative read trimming", "version":"2.3.0", "scope":"Optional route"},
    {"tool":"Trimmomatic", "package":"trimmomatic", "role":"Alternative read trimming", "version":"0.40", "scope":"Optional route"},
    {"tool":"SortMeRNA", "package":"sortmerna", "role":"Optional rRNA filtering", "version":"4.3.7", "scope":"linux-64 lock; macOS arm64 uses the separately provisioned 4.4.0 binary"},
    {"tool":"RiboDetector", "package":"ribodetector", "role":"Optional reference-free rRNA filtering", "version":"0.2.7", "scope":"Optional route"},
    {"tool":"FastQ Screen", "package":"fastq-screen", "role":"Optional contamination screen", "version":"0.16.0", "scope":"QC report; unavailable on macOS arm64"},
    {"tool":"Bowtie2", "package":"bowtie2", "role":"FastQ Screen aligner", "version":"2.5.5", "scope":"Optional contamination screen"},
    {"tool":"RSeQC", "package":"rseqc", "role":"Optional alignment QC", "version":"5.0.4", "scope":"Aligned-read routes"},
    {"tool":"STAR", "package":"star", "role":"Spliced alignment", "version":"2.7.11b", "scope":"Default alignment route"},
    {"tool":"HISAT2", "package":"hisat2", "role":"Spliced alignment", "version":"2.2.2", "scope":"Alternative alignment route"},
    {"tool":"Salmon", "package":"salmon", "role":"Transcript quantification", "version":"1.10.3", "scope":"Alternative mapping-based route"},
    {"tool":"gffread", "package":"gffread", "role":"Transcriptome construction", "version":"0.12.9", "scope":"Salmon reference route"},
    {"tool":"featureCounts", "package":"subread", "role":"Gene-level counting", "version":"2.1.1", "scope":"Provided by Subread"},
    {"tool":"tximport", "package":"bioconductor-tximport", "role":"Gene-level Salmon import", "version":"1.38.2", "scope":"Main analysis package"},
    {"tool":"samtools", "package":"samtools", "role":"BAM indexing and summaries", "version":"1.22.1", "scope":"Aligned-read routes"},
    {"tool":"R", "package":"r-base", "role":"Statistical runtime", "version":"4.5.2", "scope":"Direct runtime"},
    {"tool":"DESeq2", "package":"bioconductor-deseq2", "role":"Default count-model differential expression", "version":"1.50.2", "scope":"Main analysis package"},
    {"tool":"apeglm", "package":"bioconductor-apeglm", "role":"DESeq2 fold-change shrinkage", "version":"1.32.0", "scope":"Default requested shrinkage"},
    {"tool":"ashr", "package":"r-ashr", "role":"Fold-change shrinkage fallback", "version":"2.2_63", "scope":"Used when the requested apeglm fit cannot be made"},
    {"tool":"limma", "package":"bioconductor-limma", "role":"Microarray and voom differential expression", "version":"3.66.0", "scope":"Optional engine or input route"},
    {"tool":"edgeR", "package":"bioconductor-edger", "role":"TMM/voom support and QLF cross-check", "version":"4.8.2", "scope":"Optional engine"},
    {"tool":"HTSFilter", "package":"bioconductor-htsfilter", "role":"Per-study meta-analysis filtering", "version":"1.50.0", "scope":"Meta-analysis only"},
    {"tool":"metaRNASeq", "package":"r-metarnaseq", "role":"Inverse-normal p-value combination", "version":"1.0.8", "scope":"Main analysis package"},
    {"tool":"metafor", "package":"r-metafor", "role":"Pooled effect-size models", "version":"5.0_1", "scope":"Main analysis package"},
    {"tool":"AnnotationDbi", "package":"bioconductor-annotationdbi", "role":"Identifier and annotation access", "version":"1.72.0", "scope":"Main annotation package"},
    {"tool":"clusterProfiler", "package":"bioconductor-clusterprofiler", "role":"GO, KEGG and custom-set enrichment", "version":"4.18.4", "scope":"Main enrichment package"},
    {"tool":"gprofiler2", "package":"r-gprofiler2", "role":"Optional online annotation service client", "version":"0.2.4", "scope":"Package pin; retrieved database content is recorded by the run, not versioned here"},
    {"tool":"fgsea", "package":"bioconductor-fgsea", "role":"Ranked gene-set enrichment", "version":"1.36.2", "scope":"Main enrichment package"},
    {"tool":"GSVA", "package":"bioconductor-gsva", "role":"Optional sample-level pathway scores", "version":"2.4.4", "scope":"Custom-GMT workflow"},
    {"tool":"enrichplot", "package":"bioconductor-enrichplot", "role":"Enrichment visualisation", "version":"1.30.4", "scope":"Main figure package"},
    {"tool":"ggplot2", "package":"r-ggplot2", "role":"Statistical figures", "version":"4.0.3", "scope":"Selected figure package"},
    {"tool":"pheatmap", "package":"r-pheatmap", "role":"Heatmaps", "version":"1.0.13", "scope":"Selected figure package"},
    {"tool":"ggrepel", "package":"r-ggrepel", "role":"Collision-aware figure labels", "version":"0.9.8", "scope":"Selected figure package"},
    {"tool":"svglite", "package":"r-svglite", "role":"SVG figure output", "version":"2.2.2", "scope":"Selected figure package"}
  ]
}
